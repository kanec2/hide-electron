			}

			var scene : hide.comp.Scene = null;
			var modelView = Std.downcast(currentView, hide.view.Model);
			if (modelView != null)
				scene = @:privateAccess modelView.scene;
			var prefabView = Std.downcast(currentView, hide.view.Prefab);
			if (prefabView != null)
