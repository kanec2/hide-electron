    }

    MathOperation.values = ["+", "-", "*", "/", "%", "^", "max", "min"];
    MathOperation.funcs = {
        "+": function(A,B) { return A + B; },
        "-": function(A,B) { return A - B; },
        "x": function(A,B) { return A * B; },
        "X": function(A,B) { return A * B; },
        "*": function(A,B) { return A * B; },
        "/": function(A,B) { return A / B; },
        "%": function(A,B) { return A % B; },
        "^": function(A,B) { return Math.pow(A, B); },
        "max": function(A,B) { return Math.max(A, B); },
