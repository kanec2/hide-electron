    public function new() {
        super();
        // ✅ Получаем рендерер из DI, а не создаём h3d.Engine вручную!
        previewRenderer = UseService.shaderPreviewRenderer();
        litegraphContainerRef = untyped React.createRef();
        state = { graph: null, selectedNode: null };
