	var Enum = 12;
	var Field = 4;
	var File = 16;
	var Folder = 18;
	var Function = 2;
	var Interface = 7;
	var Keyword = 13;
	var Method = 1;
	var Module = 8;
	var Property = 9;
	var Reference = 17;
	var Snippet = 14;
	var Text = 0;
	var Unit = 10;
	var Value = 11;
