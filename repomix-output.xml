    /**
     * Показывает диалог сохранения файла.
     */
    function showSave(?options: { ?filters: Array<FileFilter>, ?defaultPath: String }): Future<Null<String>>;
    
    /**
     * Показывает диалог выбора директории.
     */
    function showDirectory(): Future<Null<String>>;
}
