package haxeLanguageServer.protocol;

import haxe.display.JsonModuleTypes;

using Lambda;

class ExtensionsTest extends Test {
	function testResolveImports() {
		final imports = Extensions.resolveImports({
			kind: TInst,
			args: {
				path: {
					typeName: "Vector",
					pack: ["haxe", "ds"],
					moduleName: "Vector",
					importStatus: Unimported
				},
				params: [
					{
						kind: TInst,
						args: {
							path: {
								typeName: "PosInfos",
								pack: ["haxe"],
								moduleName: "PosInfos",
								importStatus: Unimported
							}
						}
					}
				]
			}
		});
