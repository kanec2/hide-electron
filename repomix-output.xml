		final newText = args?.newCode;
		if (range == null) {
			return [];
		}
		return [
			{
				title: newText == null || newText == "" ? "Remove" : 'Replace with $newText',
				kind: QuickFix,
				edit: WorkspaceEditHelper.create(context, params, @:nullSafety(Off) [
					{
						range: range,
						newText: newText
					}
				]),
				diagnostics: [diagnostic],
				isPreferred: true
			}
		];
	}
}
