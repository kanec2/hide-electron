	var explicitPrivate:Bool;
	var explicitNull:Bool;
}

enum abstract ReturnTypeHintOption(String) {
	final Always = "always";
	final Never = "never";
	final NonVoid = "non-void";
}

private typedef FunctionGenerationConfig = {
