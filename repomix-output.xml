		var css = new js.jquery.JQuery('link[type="text/css"]');
		css.each(function(i, e) : Void {
			var link : js.html.LinkElement = cast e;
			if (path == null || StringTools.contains(link.href, path)) {
				link.href = link.href + "?" + haxe.Timer.stamp();
